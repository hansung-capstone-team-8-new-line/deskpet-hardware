# ~/.config/deskpet-hardware/kiosk.env — read by deskpet-xsession at every kiosk start.
# Leave a line commented to use the default. Output names come from: DISPLAY=:0 xrandr --query
#DESKPET_OUTPUT=DP-0
#DESKPET_MODE=1024x600
#DESKPET_ROTATE=normal
#DESKPET_CONFIG=/home/<user>/.config/deskpet-hardware/config.json
